# Coolify / Yerel Geliştirme Ortam Değişkenleri
# Gerçek sırları asla bu dosyaya ya da git deposuna yazmayın; canlı değerleri
# yalnızca Coolify > Environment Variables ekranında tutun.

# PostgreSQL bağlantısı (harici TLS gerektiren DB için ?sslmode=require ekleyin)
DATABASE_URL=postgresql://KULLANICI:SIFRE@HOST:5432/VERITABANI
# Özel CA sertifikası gerekirse (isteğe bağlı, dosya yolu veya PEM metni):
# PGSSLROOTCERT=/path/to/ca.crt

# Oturum güvenliği (üretimde en az 32 bayt zorunlu: openssl rand -hex 32)
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Yönetici girişi
ADMIN_USERNAME=yonetici-kullanici-adi
ADMIN_PASSWORD=guclu-bir-sifre-buraya

# Sunucu
NODE_ENV=development
PORT=5001

# WhatsApp Ayarları
WHATSAPP_PHONE=905306042829
WHATSAPP_MESSAGE=Merhaba! Size nasıl yardımcı olabilirim?
WHATSAPP_ENABLED=true
